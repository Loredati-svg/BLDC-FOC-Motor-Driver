	(text "Schottky diode-OR - lets USB power the logic rail (+5V)\nwhen no battery is connected, and blocks the DRV8323 buck output from\nback-feeding into the host's USB port."
		(exclude_from_sim no)
		(at 75.946 80.772 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "013c3882-4b0c-4303-9df3-3a24732f22c7")
	)
	(text "D1 TVS diode clamps VBAT transients, e.g. regenerative braking energy\npumped back by the motor through the inverter, hot-plug ringing\nand switching spikes keeping the rail below the MOSFET (60 V) and DRV8323 (65 V) limits."
		(exclude_from_sim no)
		(at 55.118 40.132 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "4bc08796-6435-443a-8373-6517372e2b38")
	)
